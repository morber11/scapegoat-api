PROVIDER_API_KEY=your-api-key-here
PROVIDER_MODEL=gemini-2.5-flash

APP_ENV=development          # development / production
PROVIDER=gemini              # gemini / deepseek - add new providers in src/api/dependencies.py
REQUEST_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=            # comma-separated list of permitted CORS origins (empty=>no origins, * allowed in development)
